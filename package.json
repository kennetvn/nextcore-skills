{
  "name": "nextcore-skills",
  "version": "1.9.1",
  "private": true,
  "description": "Skills from a real product: nextcore-design (UI), nextcore-dev (frontend <-> backend contract), nextcore-workflow (running AI agents). Zero-dependency tools: slop-check, token-audit, design-card, design-review, doc-drift.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kennetvn/nextcore-skills.git"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "slop-check": "plugins/nextcore-design/skills/nextcore-design/scripts/slop-check.mjs",
    "token-audit": "plugins/nextcore-design/skills/nextcore-design/scripts/token-audit.mjs",
    "design-card": "plugins/nextcore-design/skills/nextcore-design/scripts/design-card.mjs",
    "design-review": "plugins/nextcore-design/skills/nextcore-design/scripts/design-review.mjs",
    "doc-drift": "plugins/nextcore-workflow/skills/nextcore-workflow/scripts/doc-drift.mjs",
    "third-patch": "plugins/nextcore-workflow/skills/nextcore-workflow/scripts/third-patch.mjs",
    "spec-check": "plugins/nextcore-design/skills/nextcore-design/scripts/spec-check.mjs",
    "nextcore-install": "tools/nextcore-install.mjs",
    "nextcore": "tools/nextcore.mjs"
  },
  "scripts": {
    "test": "node --test tests/hub.test.mjs plugins/nextcore-design/tests/tools.test.mjs",
    "cases": "node tools/cases-index.mjs"
  },
  "keywords": [
    "agent-skills",
    "claude-code",
    "claude-plugins",
    "design-first",
    "design-tokens",
    "wcag",
    "api-contract",
    "ai-agents",
    "laravel",
    "nextjs"
  ]
}
